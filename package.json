{
  "name": "bilimani-workspace",
  "private": true,
  "version": "0.4.1",
  "type": "module",
  "workspaces": [
    "web/packages/*",
    "web/apps/*"
  ],
  "scripts": {
    "build": "npm run build -w @bilimani/iidx",
    "build:preview": "node web/apps/iidx/build.mjs --preview",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test web/tests/*.test.ts",
    "test:browser": "node web/tests/browser.mjs",
    "test:browser:arm": "node web/tests/choice-arm.browser.mjs",
    "test:browser:startup": "node web/tests/startup.browser.mjs",
    "test:browser:preview": "node web/tests/preview.browser.mjs",
    "dev": "npm run dev -w @bilimani/iidx"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "playwright": "^1.64.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.0"
  }
}
